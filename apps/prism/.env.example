# -----------------------------------------------------------------------------
# Prism — environment variables (Vite, client-side only)
# Copy this file to `.env.local` and fill in your own values.
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# Spotify application Client ID.
# Create an app at https://developer.spotify.com/dashboard
# The app type can be "Web" and does NOT need a client secret for PKCE.
VITE_SPOTIFY_CLIENT_ID=

# Redirect URI registered in the Spotify dashboard.
# Must match EXACTLY (including scheme, host, path and trailing slash).
# The callback route is handled client-side by the auth module.
# For local development Spotify requires the loopback IP, not "localhost":
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
